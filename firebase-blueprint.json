{
  "entities": {
    "User": {
      "title": "User",
      "description": "Marketplace visitor or recipient profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "recipient"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "isAnonymous", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Technology hardware, vehicle, or equipment listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "sectionId": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "specs": { "type": "object" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "inventoryCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "sectionId", "category", "price", "images", "description"]
    },
    "Article": {
      "title": "Article",
      "description": "Deep-dive technology updates and scientific publications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "sectionId": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "readTime": { "type": "string" },
        "coverImage": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "sectionId", "coverImage", "content"]
    },
    "Category": {
      "title": "Category",
      "description": "Taxonomy node within one of the 9 technology sections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionId": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "sectionId", "name", "slug"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private 1-to-1 conversation between a visitor and designated website recipient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "visitorName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "accepted", "declined"] },
        "lastMessageText": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadAdminCount": { "type": "number" },
        "unreadVisitorCount": { "type": "number" },
        "isBlocked": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "visitorId", "status", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Persistent real-time message (text, photo, or voice note) in a private conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "from": { "type": "string", "enum": ["visitor", "recipient", "admin"] },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "messageType": { "type": "string", "enum": ["text", "image", "voice"] },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "audioUrl": { "type": "string" },
        "audioDuration": { "type": "number" },
        "time": { "type": "string" },
        "real": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "from", "text", "time", "real", "createdAt"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "User bookmarked item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itemId": { "type": "string" },
        "itemType": { "type": "string", "enum": ["product", "article"] },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "price": { "type": "number" },
        "sectionId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "itemId", "itemType", "title"]
    },
    "InvestmentWatchlist": {
      "title": "InvestmentWatchlist",
      "description": "Personal investor watchlist entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "targetPrice": { "type": "number" },
        "notes": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "userId", "symbol", "name"]
    },
    "Verification": {
      "title": "Verification",
      "description": "Public ownership and authenticity verification disclosure record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "legalOwnerName": { "type": "string" },
        "operatingCompanyName": { "type": "string" },
        "officialContactEmail": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check document for connection verification",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Visitor and user profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Marketplace products across 9 technology sections"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Technology articles and research publications"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Section categories and catalog hierarchy"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Private visitor-to-recipient direct conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Text, photo, and voice messages inside a private conversation"
    },
    "/savedItems/{savedItemId}": {
      "schema": "SavedItem",
      "description": "User bookmarked products and articles"
    },
    "/investmentWatchlists/{watchlistId}": {
      "schema": "InvestmentWatchlist",
      "description": "Personal investment watchlists"
    },
    "/verification/{docId}": {
      "schema": "Verification",
      "description": "Ownership and authenticity verification disclosure"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Health check and connection verification"
    }
  }
}
