rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'elonmusk241@gmail.com' ||
          request.auth.token.email.lower() == 'sirrodstephen@gmail.com'
        )) ||
        (request.auth.uid == '4W2iB38N41cR0hXfN1tP4f4M5uE2') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidVisitorConversationId(conversationId) {
      return conversationId.matches('^conv_(anon_)?[A-Za-z0-9_-]{8,64}$');
    }

    function isConversationParticipant(conversationId) {
      return (isSignedIn() && (
        conversationId == 'conv_' + request.auth.uid ||
        (resource != null && resource.data.get('visitorId', '') == request.auth.uid)
      )) || isValidVisitorConversationId(conversationId);
    }

    // Health check & connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // Administrators Collection (Restricted to owner or matching authenticated UID)
    match /admins/{adminId} {
      allow read: if isOwnerAdmin() || (isSignedIn() && (request.auth.uid == adminId || adminId == '4W2iB38N41cR0hXfN1tP4f4M5uE2'));
      allow write: if isOwnerAdmin() || (isSignedIn() && (
        request.auth.uid == '4W2iB38N41cR0hXfN1tP4f4M5uE2' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'elonmusk241@gmail.com' ||
          request.auth.token.email.lower() == 'sirrodstephen@gmail.com'
        ))
      ));
    }

    // Users Collection (Public profiles with admin management)
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow delete: if isOwnerAdmin();
    }

    // Products Catalog (Public catalog browsing, Admin-only modifications)
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Articles & Deep Dives (Public reading, Admin-only publishing)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Categories Hierarchy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Private Conversations (Visitors manage their own exact thread ID; only Admin can list all or block)
    match /conversations/{conversationId} {
      allow list: if isOwnerAdmin();
      allow get: if isOwnerAdmin() || isConversationParticipant(conversationId);
      allow create: if isOwnerAdmin() || (
        isConversationParticipant(conversationId) &&
        request.resource.data.visitorId is string &&
        request.resource.data.get('isBlocked', false) == false
      );
      allow update: if isOwnerAdmin() || (
        isConversationParticipant(conversationId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked'])) &&
        resource.data.get('isBlocked', false) == false
      );
      allow delete: if isOwnerAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isOwnerAdmin() || (
          isSignedIn() && (
            conversationId == 'conv_' + request.auth.uid ||
            (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('visitorId', '') == request.auth.uid)
          )
        ) || isValidVisitorConversationId(conversationId);

        allow create: if isOwnerAdmin() || (
          (isSignedIn() || isValidVisitorConversationId(conversationId)) &&
          request.resource.data.from == 'visitor' &&
          request.resource.data.conversationId == conversationId &&
          (
            !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('isBlocked', false) == false
          )
        );
        allow update, delete: if isOwnerAdmin();
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Saved Items / Bookmarks
    match /savedItems/{savedItemId} {
      allow read, write: if true;
    }

    // Investment Watchlists
    match /investmentWatchlists/{watchlistId} {
      allow read, write: if true;
    }

    // User Moderation Reports (Public create, Admin-only triage and resolution)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isOwnerAdmin();
    }

    // Admin Audit Logs (Strictly Admin-only)
    match /adminAuditLogs/{logId} {
      allow read, write: if isOwnerAdmin();
    }

    // Ownership & Authenticity Verification Records
    match /verification/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }
  }
}
