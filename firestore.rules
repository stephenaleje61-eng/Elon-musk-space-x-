rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection check
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products Collection (Public Catalog & Admin Management)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Articles Collection (Public Articles & Tech Updates)
    match /articles/{articleId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Conversations Collection (Real Human Chat & Join Requests)
    match /conversations/{conversationId} {
      allow read, write: if true;

      // Nested Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Saved Items / Bookmarks
    match /savedItems/{savedItemId} {
      allow read, write: if true;
    }

    // Investment Watchlists
    match /investmentWatchlists/{watchlistId} {
      allow read, write: if true;
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
