rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'sirrodstephen@gmail.com') ||
        (request.auth.uid == '4W2iB38N41cR0hXfN1tP4f4M5uE2') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health check & connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // Administrators Collection (Restricted to owner or matching authenticated UID)
    match /admins/{adminId} {
      allow read: if isOwnerAdmin() || (isSignedIn() && (request.auth.uid == adminId || adminId == '4W2iB38N41cR0hXfN1tP4f4M5uE2'));
      allow write: if isOwnerAdmin() || (isSignedIn() && (request.auth.uid == '4W2iB38N41cR0hXfN1tP4f4M5uE2' || (request.auth.token.email != null && request.auth.token.email.lower() == 'sirrodstephen@gmail.com')));
    }

    // Users Collection (Public profiles with admin management)
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow delete: if isOwnerAdmin();
    }

    // Products Catalog (Public catalog browsing, Admin-only modifications)
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Articles & Deep Dives (Public reading, Admin-only publishing)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Categories Hierarchy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Private Conversations (Visitors request chat, Admin accepts and manages)
    match /conversations/{conversationId} {
      // Allow read to owner admin, or visitor accessing their own conversation
      allow read: if isOwnerAdmin() || (isSignedIn() && (resource == null || resource.data.visitorId == request.auth.uid || conversationId == 'conv_' + request.auth.uid));
      // Create conversation
      allow create: if isSignedIn() || isOwnerAdmin();
      // Only admin can toggle isBlocked; non-admins can update their conversation as long as not changing isBlocked
      allow update: if isOwnerAdmin() || (
        isSignedIn() &&
        (resource.data.visitorId == request.auth.uid || conversationId == 'conv_' + request.auth.uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked'])) &&
        (!resource.data.isBlocked)
      );
      allow delete: if isOwnerAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        // Read messages: admin or conversation owner
        allow read: if isOwnerAdmin() || (
          isSignedIn() && 
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.visitorId == request.auth.uid || conversationId == 'conv_' + request.auth.uid)
        );
        // Create message: allowed if admin OR (conversation is NOT blocked)
        allow create: if isOwnerAdmin() || (
          isSignedIn() &&
          (!get(/databases/$(database)/documents/conversations/$(conversationId)).data.isBlocked)
        );
        allow update, delete: if isOwnerAdmin();
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Saved Items / Bookmarks
    match /savedItems/{savedItemId} {
      allow read, write: if true;
    }

    // Investment Watchlists
    match /investmentWatchlists/{watchlistId} {
      allow read, write: if true;
    }

    // User Moderation Reports (Public create, Admin-only triage and resolution)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isOwnerAdmin();
    }

    // Admin Audit Logs (Strictly Admin-only)
    match /adminAuditLogs/{logId} {
      allow read, write: if isOwnerAdmin();
    }

    // Ownership & Authenticity Verification Records
    match /verification/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }
  }
}
